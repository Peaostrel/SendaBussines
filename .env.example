# Copy the API rows into apps/api/.env and the web rows into apps/web/.env.local.
# See apps/api/.env.example and apps/web/.env.example. Do not commit filled copies.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Server only, apps/api/.env. Leave empty in git. SESSION_SECRET needs at least 32 characters.
# The SEP10_SIGNING_SECRET account must be different from STELLAR_ADMIN_PUBLIC.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SESSION_SECRET=
STELLAR_ADMIN_PUBLIC=
SEP10_SIGNING_SECRET=
SEP10_HOME_DOMAIN=localhost
# Trustless Work v2 beta. Empty here. API only, never NEXT_PUBLIC_*.
TRUSTLESS_WORK_API_KEY=
TREASURY_SECRET=
# Secret keys (S…) for the escrow admin and the dispute resolver.
# The operator holds these only in the local env. Never commit them.
# They exist so funded escrows can be updated or a dispute can be resolved.
# Placeholders only. The API derives their public keys at startup.
ESCROW_ADMIN_SECRET=
ESCROW_DISPUTE_RESOLVER_SECRET=

# Web app. Google sign-in stays off when the Privy id is empty.
NEXT_PUBLIC_PRIVY_APP_ID=
# The panel reads API_URL. It does not read NEXT_PUBLIC_API_URL.
API_URL=http://127.0.0.1:4000

# Sprint, not used yet. The API and the web app do not read these.
# ANCHOR_HOME_DOMAIN=testanchor.stellar.org
# ANCHOR_ASSET_CODE=USDC
# ANCHOR_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
